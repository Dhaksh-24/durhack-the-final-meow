# secrets -- never commit the real one
.env

# model weights -- auto-downloaded on first run, keep them out of git
*.pt
weights/

# python
__pycache__/
*.pyc
venv/
.venv/

# datasets and training output -- large, re-downloadable
data/
runs/
.venv-roboflow/
test_out/

# multicam.py runtime output -- regenerated every run
memory/
events.jsonl
trace-events.jsonl
cameras.json
zones.json
baseline/

# tts.py output -- regenerate with: python tts.py --samples / --prerender
samples/
audio/
out.wav

# whereabouts.py runtime log -- regenerated every run
timeline.jsonl

# the room the page built (per laptop; the page saves it through /api/room)
room.json
# room.py's camera places (per laptop; built by multicam.py / python room.py build)
places.json

# recordings and test videos of the room (people in them)
*.mp4
*.mov
*.avi
*.webm
# recorded event runs (e.g. backup-run.jsonl) and every other runtime log; the scripted sample stays
*.jsonl
!trace-sim/sample-events.jsonl
# multicam.py's half-written saves (atomic_write), the old one-camera chain's furniture files
*.tmp
anchors.json
